---
// P1修复 (2026-08-04, Codex审计): 博客此前任意不存在URL都返回 200+首页内容(软404),
// 稀释抓取预算。Cloudflare Pages 对静态构建的 404.html 会以真 404 状态码返回。
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | UCarsea Insights"
  description="The page you are looking for does not exist."
>
  <section class="uc-hero">
    <div class="uc-wrap-narrow" style="text-align:center; padding:4rem 0;">
      <h1>404 — Page Not Found</h1>
      <p style="margin:1.5rem 0;">The article you are looking for has moved or never existed.</p>
      <p>
        <a href="/">Browse all articles</a> ·
        <a href="https://ucarsea.com/inventory/">View current inventory</a>
      </p>
    </div>
  </section>
</BaseLayout>
